{
  "$comment": "Mutation gate config. threshold = minimum Stryker mutation score (%) per module; ratchet with `npm run test:mutation -- --update-thresholds`. Paths are compiled dist files because the core tests import ../dist. See doc/MUTATION_TESTING.md.",
  "timeoutMS": 10000,
  "modules": {
    "command-hardline": {
      "description": "bash hard-block analysis (sandbox/command-hardline.ts)",
      "mutate": ["packages/core/dist/sandbox/command-hardline.js"],
      "testFiles": ["packages/core/test/command-hardline.test.js"],
      "skipTests": [
        "fork bomb detection is linear on adversarial input",
        "resource exhaustion (deeply nested substitutions) does not throw or block",
        "does not change the substitution-nesting resource exhaustion behaviour",
        "stays fast on huge inputs and doubling variables"
      ],
      "threshold": 0
    },
    "bot-policy": {
      "description": "bot tool allowlists / policy warnings (bots/bot-policy.ts)",
      "mutate": ["packages/core/dist/bots/bot-policy.js"],
      "testFiles": ["packages/core/test/bot-policy.test.js"],
      "threshold": 0
    },
    "model-fallback-chain": {
      "description": "model fallback chain (model/fallback-chain.ts)",
      "mutate": ["packages/core/dist/model/fallback-chain.js"],
      "testFiles": ["packages/core/test/model-fallback.test.js"],
      "threshold": 0
    },
    "model-error-class": {
      "description": "upstream error classification (model/error-class.ts)",
      "mutate": ["packages/core/dist/model/error-class.js"],
      "testFiles": ["packages/core/test/model-fallback.test.js"],
      "threshold": 0
    },
    "memory-namespace": {
      "description": "bot memory namespace isolation (memory/bot-memory-scope.ts + agent_id filters in memory/store.ts)",
      "mutate": [
        "packages/core/dist/memory/bot-memory-scope.js",
        {
          "file": "packages/core/dist/memory/store.js",
          "functions": ["ownerClause", "isSessionScope", "pushAgentFilter", "set", "get", "search", "ftsSearch", "enforceLimit"]
        }
      ],
      "testFiles": ["packages/core/test/bot-memory-namespace.test.js"],
      "threshold": 0
    },
    "skill-proposal-secrets": {
      "description": "skill proposal validation + secret detection (skill-proposals/validate.ts)",
      "mutate": ["packages/core/dist/skill-proposals/validate.js"],
      "testFiles": ["packages/core/test/skill-proposals.test.js"],
      "threshold": 0
    },
    "message-agent": {
      "description": "inter-agent messaging relay / wake rules (tools/message-agent.ts)",
      "mutate": ["packages/core/dist/tools/message-agent.js"],
      "testFiles": ["packages/core/test/message-agent.test.js"],
      "threshold": 0
    }
  }
}
