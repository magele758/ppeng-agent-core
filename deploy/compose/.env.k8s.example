# 复制为 .env.k8s 后配合 docker-compose.k8s.yml 使用，不要提交。
# docker compose --env-file .env.k8s -f docker-compose.k8s.yml up -d

GHCR_IMAGE_PREFIX=ghcr.io/magele758/ppeng-agent-core
IMAGE_TAG=nightly

# 可选：与 daemon / Lab 同源鉴权。空 = 集群内不鉴权。
RAW_AGENT_AUTH_TOKEN=

# 可选：从未在 Lab 保存过模型时的回退。日常请在 Lab「模型服务商」里配。
RAW_AGENT_BASE_URL=
RAW_AGENT_API_KEY=
RAW_AGENT_MODEL_NAME=
